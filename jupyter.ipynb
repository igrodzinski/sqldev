# 1. Import narzędzi
from dotenv import load_dotenv
import os
from oracledb_utils import OracleDB

# 2. Wczytanie zmiennych z .env lub systemowych
load_dotenv()

USER = os.getenv("ORACLE_USER")
PASSWORD = os.getenv("ORACLE_PASSWORD")
DSN = os.getenv("ORACLE_DSN")

# 3. Zapytanie SQL
SQL = "SELECT empno, ename, job FROM emp"

# 4. Czy zapisać wynik do pliku
SAVE_TO_XLSX = True
XLSX_FILENAME = "wynik.xlsx"

# 5. Połączenie i wykonanie zapytania
db = OracleDB(USER, PASSWORD, DSN)
result = db.execute_query(SQL, save_to_xlsx=SAVE_TO_XLSX, xlsx_filename=XLSX_FILENAME)

if result is not None:
    display(result.head())

db.close()
