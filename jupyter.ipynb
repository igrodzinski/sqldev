# 1. Import narzędzi
from dotenv import load_dotenv
import os
from sqldev import OracleDB
import json

# 2. Wczytanie zmiennych z .env
load_dotenv()
prefix = ""

USER = os.getenv(f"ORACLE_USER{prefix}")
PASSWORD = os.getenv(f"ORACLE_PASSWORD{prefix}")
DSN = os.getenv(f"ORACLE_DSN{prefix}")

# 3. Wczytaj plik JSON z zapytaniami
with open("queries.json", "r", encoding="utf-8") as f:
    queries = json.load(f)

# 4. Połączenie
db = OracleDB(USER, PASSWORD, DSN)

# 5. Pętla po zapytaniach
for filename, sql in queries.items():
    print(f"\n▶️ Wykonywanie zapytania dla pliku: {filename}")
    result = db.execute_query(sql, save_to_xlsx=True, xlsx_filename=filename)
    
    if result is not None:
        display(result.head())

        # 6. Zamknięcie połączenia
db.close()





